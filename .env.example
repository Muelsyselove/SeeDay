# Device tokens: format is token:device_id:device_name:platform
DEVICE_TOKEN_1=changeme_token1:my-pc:My PC:windows
DEVICE_TOKEN_2=changeme_token2:my-phone:My Phone:android

# HMAC secret for hashing window_title (used for dedup, prevents rainbow table attacks)
# Generate with: openssl rand -hex 32
HASH_SECRET=changeme_generate_a_random_secret

# ==========================================
# AI API Configuration
# ==========================================

# AI API Key - Get yours at: https://platform.deepseek.com/api_keys
# Replace "your_api_key_here" with your actual DeepSeek API key (starts with "sk-")
AI_API_KEY=your_api_key_here

# AI API Endpoint URL (default: DeepSeek API)
# Supported providers:
#   - DeepSeek: https://api.deepseek.com/chat/completions
#   - OpenAI:   https://api.openai.com/v1/chat/completions
#   - Ollama:   http://localhost:11434/v1/chat/completions
AI_API_URL=https://api.deepseek.com/chat/completions

# AI Model name (default: deepseek-v4-flash)
# Supported DeepSeek models:
#   - deepseek-v4-flash  (default, fast & cost-effective)
#   - deepseek-v4-pro    (higher quality, more expensive)
#   - deepseek-chat      (legacy, deprecated on 2026/07/24)
# Other providers examples:
#   - gpt-4o-mini        (OpenAI)
#   - gpt-4o             (OpenAI)
#   - claude-3-5-sonnet  (Anthropic, via compatible endpoint)
AI_MODEL=deepseek-v4-flash
